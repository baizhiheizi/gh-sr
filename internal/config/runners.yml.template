# Self-hosted runner manager configuration
# Edit this file, then run: gh sr up
# Authentication: run `gh auth login` — gh sr uses the GitHub CLI token only.

# Optional: customize the locally built container runner image (runner_mode: container).
# Applies globally; the image tag gains a suffix when extra_apt_packages is set.
# base_image pins the fork actions-runner base image (tag or @sha256 digest);
# changing it requires `gh sr rebuild <name>`.
# See docs: guides/agentic-workflows.md (container mode).
#
# container_runner_image:
#   base_image: ghcr.io/falcondev-oss/actions-runner:2.338.0
#   extra_apt_packages:
#     - ffmpeg
#     - sqlite3

# Optional: local Actions cache server (one per Linux host, auto-deployed as a
# gh-sr-cache container by `gh sr up`/`gh sr setup`). Container-mode runners
# restore/save cache from it instead of GitHub's cache service; artifacts and
# other Actions results still pass through to GitHub. Native (macOS/Windows)
# runners are not affected.
#
# cache:
#   enabled: true                     # default true on Linux hosts; set false to opt out
#   port: 27420                       # host port for the cache API (built-in default; override on collision)
#   # bind_addr: 172.17.0.1           # default: docker0 gateway IP (containers can reach it;
#   #                                 # 0.0.0.0 works but exposes the API to your LAN)
#   # storage_path: ~/.gh-sr/cache    # persistent cache data on the host
#   # retention_days: 90              # delete entries older than N days (0 = server default)
#   # max_size_bytes: 10737418240     # hard cap on cache size (0 = unlimited)
#   # max_usage_percent: 90           # skip writes when disk usage exceeds this (0 = server default)
#   # image: ghcr.io/falcondev-oss/github-actions-cache-server:latest  # pin a digest for reproducibility
#   # management_api_key: env:CACHE_MGMT_KEY  # env ref; enables `gh sr cache prune` delete operations
#   # url_override: http://10.0.0.5:3000/  # escape hatch: force the runner-facing URL
#
# Optional: Docker registry pull-through mirror (one per Linux host,
# auto-deployed as a gh-sr-registry container by `gh sr up`/`gh sr setup`).
# Container-mode runners' inner Docker pulls Docker Hub images through it, so
# every runner on the host shares one copy of each image layer instead of
# each downloading it over the WAN. Only Docker Hub is redirected
# transparently (dockerd's registry-mirrors has no per-registry equivalent
# for ghcr.io). Native (macOS/Windows) runners are not affected.
#
# registry_mirror:
#   enabled: true                     # default true on Linux hosts; set false to opt out
#   port: 5577                        # host port for the mirror API (built-in default; override on collision)
#   # bind_addr: 172.17.0.1           # default: docker0 gateway IP + loopback (containers and
#   #                                 # host-side prefetch pulls); 0.0.0.0 exposes it to your LAN
#   # storage_path: ~/.gh-sr/registry # mirrored image layers on the host
#   # upstream: https://registry-1.docker.io  # registry the mirror pulls through
#   # image: registry:2               # pin a digest for reproducible deploys
#   # url_override: http://10.0.0.5:5577  # escape hatch: force the runner-facing URL
#   # Extra pull-through mirrors (dockerd can only mirror Docker Hub transparently;
#   # other registries pair a mirror with the prefetch sync below — gh sr images sync):
#   # mirrors:
#   #   - name: ghcr                  # container gh-sr-registry-ghcr, port 5578
#   #     upstream: https://ghcr.io
#   #     # username: ci-bot          # optional: private GHCR
#   #     # password_env: GHCR_PAT    #   PAT read from the environment, never stored here
#   # prefetch:                       # pulled once per host, loaded into every runner
#   #   - ghcr.io/github/gh-aw-firewall/agent:latest
#   #   - ghcr.io/github/gh-aw-mcpg:latest
#
# Optional: npm registry override for container-mode runners. Written to the
# runner user's ~/.npmrc (npm/npx/pnpm/bun all read it) so package installs
# come from a mirror reachable without the WAN proxy — e.g. on China-network
# hosts. Empty = npm's default registry. `gh sr rebuild` applies it.
#
# npm_registry: https://registry.npmmirror.com
#
# Optional: shared cache volumes mounted into every container runner on a
# host (defaults on). One npm cacache, ~/.cache, Gradle, pub and mise dir
# shared by all runners: cold caches are paid once per host and survive
# rebuilds. The .toolcache is NOT shared (it is seeded by the
# container_runner_image.toolcache bake). The Android SDK is opt-in (large).
#
# shared_caches:
#   enabled: true                     # master switch, default true
#   npm: true                         # gh-sr-npm-cache at /home/runner/.npm
#   home_cache: true                  # gh-sr-runner-cache at /home/runner/.cache
#   gradle: true                      # gh-sr-gradle-cache at /home/runner/.gradle
#   pub: true                         # gh-sr-pub-cache at /home/runner/.pub-cache
#   mise: true                        # gh-sr-mise-data at /home/runner/.local/share/mise
#   android_sdk: false                # gh-sr-android-sdk at /opt/android-sdk (opt-in)
hosts:
  # Example hosts (os and arch are auto-detected over SSH -- you only need addr):
  #
  # mac-mini:
  #   addr: user@192.168.1.50   # SSH target (os/arch auto-detected)
  #
  # win-pc:
  #   addr: user@192.168.1.51   # SSH target (os/arch auto-detected)
  #   # windows_ps: pwsh   # optional: use pwsh.exe instead of powershell.exe for remote scripts
  #
  # vps-1:
  #   addr: root@203.0.113.10   # os/arch auto-detected
  #
  # Local host (the machine running gh sr):
  #
  # my-laptop:
  #   addr: local              # runs commands locally instead of over SSH
  #   # os and arch are auto-detected; override if needed

runners:
  # Example runners:
  #
  # - name: my-project-mac
  #   repo: owner/repo
  #   host: mac-mini
  #   count: 1
  #   labels: [self-hosted, macOS, ARM64]
  #
  # - name: my-project-win
  #   repo: owner/repo
  #   host: win-pc
  #   count: 1
  #   labels: [self-hosted, Windows, X64]
  #
  # - name: my-project-ci
  #   repo: owner/repo
  #   host: vps-1
  #   count: 2
  #   labels: [self-hosted, Linux, X64]
  #
  # Runner on the local machine:
  #
  # - name: my-project-local
  #   repo: owner/repo
  #   host: my-laptop
  #   count: 1
  #   labels: [self-hosted, Linux, X64]
  #
  # Organization-level runner (shared across all repos in the org):
  #
  # - name: org-runner
  #   org: my-org
  #   group: my-runner-group   # optional; create the group in GitHub org settings first
  #   host: vps-1
  #   count: 2
  #   labels: [self-hosted, Linux, X64]
  #
  # Ephemeral runner (one job then auto-deregister):
  #
  # - name: ephemeral-runner
  #   repo: owner/repo
  #   host: vps-1
  #   ephemeral: true
  #
  # Agentic Workflow runner (GitHub Agentic Workflows with gh-aw):
  # profile: agentic always runs in container mode (privileged Docker-in-Docker): each
  # instance gets its own inner dockerd, network namespace, MCP gateway port, and
  # /tmp/gh-aw, and every job runs from a pristine inner state. The host only needs
  # Docker installed and privileged-container support; gh-aw, AWF, and all other
  # dependencies live inside the image gh sr builds during setup. Use count: N for N
  # concurrent agentic jobs — no MCP port/label juggling is needed (and the removed
  # agentic_mcp_ports / agentic_mcp_port_base fields are rejected if present).
  #
  # - name: agentic-runner
  #   repo: owner/repo
  #   host: vps-1
  #   count: 3             # run 3 concurrent agentic jobs safely
  #   profile: agentic     # implies runner_mode: container (DinD isolation)
  #   awf_service_bridge: true  # optional: join the job's `services:` containers to
  #                             # the AWF awf-net topology network so the sandboxed
  #                             # agent reaches them by service name (see
  #                             # guides/agentic-workflows.md; requires profile: agentic)
  #
  # Same container image (DinD + actions runner) works for ordinary CI without
  # profile: agentic — use when you want isolated dockerd and work dirs per instance:
  #
  # - name: ci-container
  #   repo: owner/repo
  #   host: vps-1
  #   count: 2
  #   runner_mode: container
